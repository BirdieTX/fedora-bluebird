#!/usr/bin/bash
# Game mode OS update for bluebird-deck. Uses rpm-ostree instead of uupd.
# check:  exit 0 = update available, exit 7 = no update (or check not possible)
# update: print "N%" lines, exit 0 = success, non-zero (not 7) = error

LOG="${HOME}/.steamos-update.log"
MARKER=/tmp/upgrade-installed
CTX=system_u:unconfined_r:unconfined_t:s0

# Bazzite first-boot fix. Without it, the first game mode start can hang.
_fixup_file=/etc/bazzite/fixups/first_steam_gamemode_boostrap
if [[ ! -f $_fixup_file ]]; then
  mkdir -p "$(dirname "$_fixup_file")"
  touch "$_fixup_file"
  sync "$_fixup_file"
  systemctl restart graphical.target
  exit 7
fi

case "$1" in
  check)
    [[ -f $MARKER ]] && exit 7                   # Update staged. Wait for reboot.
    wget -q --spider https://ghcr.io || exit 7   # No network.
    output=$(runcon "$CTX" rpm-ostree upgrade --check 2>/dev/null) || exit 7
    if grep -q "AvailableUpdate" <<< "$output"; then
      version=$(awk '/Version:/ {print $2; exit}' <<< "$output")
      echo "Update available: ${version:-unknown}"
      exit 0
    fi
    exit 7
    ;;
  update)
    [[ -f $LOG ]] && cp "$LOG" "$LOG.old"
    echo "0%"
    if ! runcon "$CTX" rpm-ostree upgrade > "$LOG" 2>&1; then
      exit 1
    fi
    touch "$MARKER"
    echo "100%"
    exit 0
    ;;
  *)
    exit 1
    ;;
esac
